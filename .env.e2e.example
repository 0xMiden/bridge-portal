# E2E harness config. Copy to .env.e2e and fill in for the real-testnet tier.
# The mock tier (npm run test:e2e:mock) needs NONE of these.

# One-knob environment (harness side). "testnet" or "mock".
E2E_NETWORK=testnet

# Funded Sepolia test key (throwaway). It signs real deposits and claims. Its USDC is
# minted fresh each run via the token's public mint(); top up its Sepolia ETH
# from a faucet (global-setup fails fast below the floor).
E2E_EVM_PRIVATE_KEY=0x...

# 32-byte seed (64 hex chars). The harness creates a public single-sig wallet
# from it, or imports that wallet once it is on chain. Bread cannot export a
# Guardian account, so there is no account file. The first send asks
# faucet.testnet.miden.io for a public note and consumes it.
E2E_MIDEN_SEED=0x...

# Optional. When set, it must be this seed's account (bech32 or 0x hex).
# Leave it unset and the signer uses the address it just created.
# E2E_MIDEN_ACCOUNT_ID=mtst1...

# Optional overrides
# E2E_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# MIDEN_CLIENT_BIN=miden-client          # path to the version-matched CLI
# E2E_AGENTIC=true                        # leave server+browser open on failure
# NEXT_PUBLIC_E2E_SIGNER_MODE=sign        # or "reject" to force a 4001

# NOTE: the Playwright e2e config forwards E2E_EVM_PRIVATE_KEY / E2E_MIDEN_SEED
# (and E2E_MIDEN_ACCOUNT_ID, when set) into the SUT build as NEXT_PUBLIC_*.
# The injected signers run in the browser. These are throwaway testnet accounts
# and only present in an E2E build. The flag is off, and the vars absent, in
# production.
