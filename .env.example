# Copy to .env.local for local development: `cp .env.example .env.local`
# All vars have in-code fallbacks, so the app runs even if these are unset.
# `NEXT_PUBLIC_*` vars are inlined into the client bundle at BUILD time — set
# them before `npm run build` (or the Docker/Cloudflare build), not just at
# runtime. The rest are read server-side by the API routes at request time.

# ─── Server-side (API routes) ────────────────────────────────────────────────

# Proxy target for /api/bridge/* (default: http://127.0.0.1:8080).
# Point at your local AggLayer/bridge backend for host development.
BRIDGE_API_BASE=http://127.0.0.1:8080

# Sepolia RPC for all /api/evm/sepolia/* reads and provider status checks.
# AGGLAYER_SEPOLIA_RPC_URL wins; EVM_RPC_URL is the secondary fallback; if both
# are unset, NEXT_PUBLIC_SEPOLIA_RPC_URL then the public node are used.
AGGLAYER_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
EVM_RPC_URL=

# ─── Client-side (NEXT_PUBLIC_*, inlined at build time) ───────────────────────

# WalletConnect / Reown project id for Ethereum (Sepolia) wallet connection.
# Leave empty for local extension testing via window.ethereum.
# Get one at https://cloud.walletconnect.com (a.k.a. https://dashboard.reown.com).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional Sepolia public RPC fallback. Browser reads go through /api/evm/sepolia/rpc;
# private server RPC overrides above take precedence.
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Arc Testnet RPC for USDCx deposits (same-origin read proxy, with public fallbacks).
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io

# Miden testnet RPC endpoint for the client-side Miden SDK.
# Defaults to https://rpc.testnet.miden.io if unset.
NEXT_PUBLIC_MIDEN_RPC_URL=https://rpc.testnet.miden.io

# Epoch Protocol allocator API base (Fast cross-chain intent route).
# Defaults to the testnet allocator if unset.
NEXT_PUBLIC_EPOCH_ALLOCATOR_URL=https://testnet-dev.epochprotocol.xyz

# App origin used for wallet-connect metadata during SSR (where `window` is
# undefined). Defaults to http://localhost:3000; set to the deployed origin
# (e.g. https://bridge.miden.xyz) in production builds.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── E2E harness ─────────────────────────────────────────────────────────────
# The Playwright e2e suite injects its own NEXT_PUBLIC_E2E_* vars into the SUT
# build (test key/seed/account signers that run in the browser). Those live in
# `.env.e2e.example` (copy to `.env.e2e`), NOT here — they must never be set in
# a production build. The mock tier (`npm run test:e2e:mock`) needs none of them.
