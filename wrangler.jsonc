{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bridge-portal",
  // The Miden org Cloudflare account (owns the miden.xyz zone). Pinned so
  // deploys don't fail account-selection when the deployer's token also sees a
  // personal account. Account ids are not secrets.
  "account_id": "a4093f504ac6cd3006ac73ab4b330f7c",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Serve the Worker at bridge.miden.xyz. `custom_domain` makes wrangler
  // provision the DNS record + edge cert in the miden.xyz zone on deploy
  // (requires the deploying account to have access to that zone).
  "routes": [{ "pattern": "bridge.miden.xyz", "custom_domain": true }]
}
