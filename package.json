{
  "name": "@miden-bridge/ui",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e:mock": "E2E_NETWORK=mock playwright test --config playwright.mock.config.ts",
    "test:e2e:testnet": "E2E_NETWORK=testnet playwright test --config playwright.e2e.config.ts",
    "playwright:install": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit",
    "check:wasm-size": "node scripts/check-wasm-size.mjs",
    "cf:build": "next build --webpack && opennextjs-cloudflare build --skipNextBuild",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@epoch-protocol/epoch-intents-sdk": "^1.0.30",
    "@gsap/react": "^2.1.2",
    "@miden-sdk/miden-sdk": "0.16.2",
    "@miden-sdk/miden-wallet-adapter-base": "0.16.2",
    "@miden-sdk/miden-wallet-adapter-react": "0.16.2",
    "@miden-sdk/react": "0.16.2",
    "@reown/appkit": "^1.8.20",
    "@reown/appkit-adapter-wagmi": "^1.8.20",
    "@tanstack/react-query": "^5.101.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "^2.51.0",
    "wagmi": "^2.19.5"
  },
  "overrides": {
    "@wagmi/core": "2.22.1",
    "@wagmi/connectors": "6.2.0",
    "@miden-sdk/miden-sdk": "0.16.2"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "msw": "^2.15.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "wrangler": "^4.105.0"
  }
}
