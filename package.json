{
  "name": "@miden-bridge/ui",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "dev": "next dev --webpack",
    "build": "npm run check:config && next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "playwright:install": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit",
    "check:wasm-size": "node scripts/check-wasm-size.mjs",
    "check:usdcx-note": "node scripts/check-arc-note.mjs",
    "check:pin-drift": "node --experimental-strip-types scripts/check-pin-drift.mjs",
    "cf:build": "npm run build && opennextjs-cloudflare build --skipNextBuild",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "config:update": "node --experimental-strip-types scripts/sync-wallet-config.mjs",
    "check:config": "node --experimental-strip-types scripts/check-wallet-config.mjs",
    "test:browser:helper": "node scripts/test-helper-browser.mjs"
  },
  "dependencies": {
    "@epoch-protocol/epoch-intents-sdk": "2.2.0",
    "@miden-sdk/miden-sdk": "0.17.6",
    "@miden-sdk/miden-wallet-adapter-base": "0.17.6",
    "@miden-sdk/miden-wallet-adapter-react": "0.17.6",
    "@miden-sdk/react": "0.17.6",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@reown/appkit": "^1.8.20",
    "@reown/appkit-adapter-wagmi": "^1.8.20",
    "@tanstack/react-query": "^5.101.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "patch-package": "8.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "^2.56.3",
    "wagmi": "^2.19.5",
    "zod": "4.4.3",
    "@coral-xyz/anchor": "0.31.1",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.99.0"
  },
  "overrides": {
    "@wagmi/core": "2.22.1",
    "@wagmi/connectors": "6.2.0",
    "@miden-sdk/miden-sdk": "0.17.6",
    "@epoch-protocol/epoch-commons-sdk": "2.1.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-sonarjs": "4.2.2",
    "msw": "^2.15.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "wrangler": "^4.105.0"
  }
}
